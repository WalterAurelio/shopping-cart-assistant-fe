{
  "printWidth": 192,
  "tabWidth": 2,
  "trailingComma": "none",
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "tailwindFunctions": ["sortCx", "cx", "cva"],
  "importOrder": [
    "^react$",
    "^react-dom$",
    "^(?!react$|react-dom$|@/|\\.).*",
    "^@/.*",
    "^\\.{1,2}/.*"
  ],
  "importOrderSeparation": false,
  "importOrderSortSpecifiers": true,
  "tailwindStylesheet": "./src/styles/globals.css"
}
